#!/usr/bin/env python3
import json
import subprocess
import urllib.request
from pathlib import Path
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import parse_qs

root = Path.home() / "lab11"
root.mkdir(exist_ok=True)

datafile = root / "training-record.txt"
datafile.write_text("LAB11_DEMO_RECORD_2026\n")

class Handler(BaseHTTPRequestHandler):
    def reply(self, status, obj):
        body = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if self.path != "/diagnose":
            return self.reply(404, {"error": "not found"})

        n = int(self.headers.get("Content-Length", 0))
        if not 0 < n <= 2048:
            return self.reply(400, {"error": "invalid length"})

        params = parse_qs(
            self.rfile.read(n).decode("utf-8", "replace")
        )

        target = params.get("host", [""])[0]

        # Intentionally weak validation for this isolated lab.
        if not target.startswith("localhost") or len(target) > 160:
            return self.reply(400, {"error": "invalid host"})

        # Deliberate OS Command Injection vulnerability.
        command = "getent hosts " + target

        result = subprocess.run(
            command,
            shell=True,
            capture_output=True,
            text=True,
            timeout=5
        )

        output = result.stdout[:1200]
        success = result.returncode == 0

        event = {
            "kind": "injection" if ";" in target else "baseline",
            "source_ip": self.client_address[0],
            "target": target,
            "command": command,
            "exit_code": result.returncode,
            "success": success
        }

        with (root / "audit.jsonl").open("a") as f:
            f.write(json.dumps(event) + "\n")

        try:
            req = urllib.request.Request(
                "http://172.29.111.30:8081/",
                data=json.dumps(event).encode(),
                headers={"Content-Type": "application/json"},
                method="POST"
            )
            urllib.request.urlopen(req, timeout=3).close()
        except Exception as exc:
            print("SOC_FORWARD_ERROR", str(exc), flush=True)

        self.reply(200, {
            "success": success,
            "output": output
        })

print("LAB11_WEB_READY", flush=True)

ThreadingHTTPServer(
    ("0.0.0.0", 8080), Handler
).serve_forever()
