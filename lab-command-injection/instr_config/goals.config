baseline_request_verified = count_greater : 0 : ( _baseline )
command_injection_verified = count_greater : 0 : ( _injection )
demo_data_access_verified = count_greater : 0 : ( _data )
web_audit_logs_verified = count_greater : 1 : ( _webbaseline, _webinjection )
soc_correlation_confirmed = count_greater : 1 : ( _socevent, _alert )
soc_investigation_completed = count_greater : 1 : ( _verdict, _impact )
